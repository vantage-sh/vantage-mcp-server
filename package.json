{
  "name": "vantage-mcp-server",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env development",
    "inspect": "mcp-inspector",
    "inspector": "mcp-inspector",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "check:lint:all": "biome check",
    "cf-typegen": "wrangler types --env development --env-file /dev/null",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "eval": "tsx evals/_lib/run-eval.ts",
    "eval:all": "tsx evals/_lib/run-eval.ts --all",
    "eval:site": "tsx evals/_lib/generate-site.ts",
    "eval:view": "PROMPTFOO_CONFIG_DIR=evals/.promptfoo promptfoo view",
    "generate-tools-index": "tsx src/tools/bin/generate-tools-index.ts",
    "generate-resources-index": "tsx src/resources/bootstrapping/bin/generate-resources-index.ts",
    "prepare": "husky",
    "local": "tsx src/local.ts",
    "local:dist": "tsx build/npm.ts",
    "print-version": "tsx src/tools/bin/print-version.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sentry/cloudflare": "10.30.0",
    "@vantage-sh/vantage-client": "2.24.0",
    "agents": "^0.13.2",
    "axios": "1.13.5",
    "hono": "4.12.12",
    "jose": "^6.0.11",
    "oauth4webapi": "^3.8.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workers-tagged-logger": "^1.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@biomejs/biome": "2.2.5",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "4.0.15",
    "ai": "^6.0.191",
    "esbuild": "^0.25.10",
    "husky": "^9.1.7",
    "promptfoo": "^0.122.0",
    "tsx": "4.21.0",
    "typescript": "^5.8.3",
    "vitest": "4.0.15",
    "wrangler": "^4.80.0"
  }
}
